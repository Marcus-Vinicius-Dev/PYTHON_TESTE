# Adicionar conteúdo ao .gitignore
@"
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
*.egg-info/
dist/
build/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# Arquivos do sistema
.DS_Store
Thumbs.db

# Logs e bancos de dados
*.log
*.sqlite
*.db

# Ambiente virtual
.venv/
"@ | Out-File -FilePath .gitignore -Encoding utf8